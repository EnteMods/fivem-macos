diff --git a/code/client/shared/StartupPhaseTrace.h b/code/client/shared/StartupPhaseTrace.h
new file mode 100644
index 0000000..ca75693
--- /dev/null
+++ b/code/client/shared/StartupPhaseTrace.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <windows.h>
+#include <cstdio>
+
+inline void CfxSourceStartupPhase(const char* phase, unsigned long value = 0)
+{
+#ifdef CFX_SOURCE_STARTUP_DIAGNOSTICS
+    const auto savedError = GetLastError();
+    char line[256];
+    std::snprintf(line, sizeof(line), "[CFX_SOURCE_PHASE] pid=%lu tid=%lu phase=%s value=%lu\n",
+                  GetCurrentProcessId(), GetCurrentThreadId(), phase, value);
+    OutputDebugStringA(line);
+    SetLastError(savedError);
+#endif
+}
+
+inline void CfxSourceStartupComponentPhase(const char* phase, const char* component)
+{
+#ifdef CFX_SOURCE_STARTUP_DIAGNOSTICS
+    const auto savedError = GetLastError();
+    char name[97];
+    size_t length = 0;
+    for (; length < sizeof(name) - 1 && component[length]; ++length)
+    {
+        const auto value = static_cast<unsigned char>(component[length]);
+        const bool allowed = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') ||
+                             (value >= '0' && value <= '9') || value == '_' || value == ':' || value == '-' || value == '.';
+        name[length] = allowed ? static_cast<char>(value) : '_';
+    }
+    name[length] = '\0';
+    char line[384];
+    std::snprintf(line, sizeof(line), "[CFX_SOURCE_COMPONENT] pid=%lu tid=%lu phase=%s component=%s\n",
+                  GetCurrentProcessId(), GetCurrentThreadId(), phase, name);
+    OutputDebugStringA(line);
+    SetLastError(savedError);
+#endif
+}
