 bool LauncherInterface::PreResumeGame()
 {
+	CfxSourceStartupPhase("citigame.pre-resume.enter");
+#ifdef CFX_SOURCE_STARTUP_DIAGNOSTICS
+	unsigned long componentIndex = 0;
+	ComponentLoader::GetInstance()->ForAllComponents([&](fwRefContainer<ComponentData> componentData)
+	{
+		CfxSourceStartupPhase("citigame.pre-resume.component.enter", ++componentIndex);
+		const auto savedError = GetLastError();
+		const auto componentName = componentData->GetName();
+		SetLastError(savedError);
+		CfxSourceStartupComponentPhase("citigame.pre-resume.component.before", componentName.c_str());
+		auto& instances = componentData->GetInstances();
+
+		if (instances.size())
+		{
+			auto& component = instances[0];
+			CfxSourceStartupComponentPhase("citigame.pre-resume.cast.before", componentName.c_str());
+			auto lifeCycle = dynamic_component_cast<LifeCycleComponent*>(component.GetRef());
+			CfxSourceStartupComponentPhase("citigame.pre-resume.cast.after", componentName.c_str());
+
+			if (lifeCycle)
+			{
+				CfxSourceStartupComponentPhase("citigame.pre-resume.callback.before", componentName.c_str());
+				lifeCycle->PreResumeGame();
+				CfxSourceStartupComponentPhase("citigame.pre-resume.callback.after", componentName.c_str());
+			}
+		}
+		CfxSourceStartupComponentPhase("citigame.pre-resume.component.after", componentName.c_str());
+	});
+#else
 	RunLifeCycleCallback([] (LifeCycleComponent* component)
 	{
 		component->PreResumeGame();
 	});
-
+#endif
+	CfxSourceStartupPhase("citigame.pre-resume.callbacks.after");
+	CfxSourceStartupPhase("citigame.pre-resume.host-shared.before");
 	static HostSharedData<UpdaterUIState> uuiState("CfxUUIState");
+	CfxSourceStartupPhase("citigame.pre-resume.host-shared.after");
 	uuiState->Close();
+	CfxSourceStartupPhase("citigame.pre-resume.ui-closed");
 
 	return true;
 }
 
