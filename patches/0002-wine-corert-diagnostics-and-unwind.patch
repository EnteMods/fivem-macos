--- /dev/null
+++ b/code/client/citicore/LoaderDiagnostics.h
@@ -0,0 +1,14 @@
+/*
+ * This file is part of the Cfx project - https://cfx.re/
+ * See LICENSE in the root of the source tree for licensing information.
+ */
+#pragma once
+
+namespace cfx::compat
+{
+inline constexpr bool HasWindowsLoaderSnapsLayout(unsigned short build, bool isWine)
+{
+    // The flag preceding Windows' _fltused export is not a Wine ABI.
+    return !isWine && build >= 18362 && build < 19628;
+}
+}
