diff --git a/code/client/shared/CrashFilterPolicy.h b/code/client/shared/CrashFilterPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..88d733bbecee8402b86dd8b5a0625acbdcfcd8fb
--- /dev/null
+++ b/code/client/shared/CrashFilterPolicy.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <windows.h>
+#include <cstdint>
+
+namespace cfx::compat
+{
+inline void ProtectUnhandledExceptionFilter(bool isWine)
+{
+    // CoreRT uses this API to chain the launcher crash reporter under Wine.
+    if (isWine)
+    {
+        return;
+    }
+
+    DWORD oldProtect;
+    LPVOID unhandledFilters[] = {
+        GetProcAddress(GetModuleHandle(L"kernelbase.dll"), "SetUnhandledExceptionFilter"),
+        GetProcAddress(GetModuleHandle(L"kernel32.dll"), "SetUnhandledExceptionFilter"),
+    };
+    for (auto unhandledFilter : unhandledFilters)
+    {
+        if (unhandledFilter)
+        {
+            VirtualProtect(unhandledFilter, 4, PAGE_EXECUTE_READWRITE, &oldProtect);
+#ifdef _M_AMD64
+            *(uint8_t*)unhandledFilter = 0xC3;
+#else
+            *(uint32_t*)unhandledFilter = 0x900004C2;
+#endif
+            VirtualProtect(unhandledFilter, 4, oldProtect, &oldProtect);
+        }
+    }
+}
+}
