diff --git a/code/client/citicore/MappingDiagnostics.h b/code/client/citicore/MappingDiagnostics.h
new file mode 100644
index 0000000000000000000000000000000000000000..403a43e19d38a6619f84375a7f9548a6324da605
--- /dev/null
+++ b/code/client/citicore/MappingDiagnostics.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <windows.h>
+#include <cstdio>
+#include <string_view>
+
+namespace cfx::compat
+{
+inline void TraceMappingProvider(const char* phase, bool registered, bool called = false, bool changed = false)
+{
+#ifdef CFX_CORE_MAPPING_DIAGNOSTICS
+    const auto savedError = GetLastError();
+    char line[256];
+    std::snprintf(line, sizeof(line),
+                  "[CFX_MAPPING] pid=%lu phase=%s provider_set=%u provider_called=%u return_changed=%u\n",
+                  GetCurrentProcessId(), phase, static_cast<unsigned>(registered),
+                  static_cast<unsigned>(called), static_cast<unsigned>(changed));
+    OutputDebugStringA(line);
+    SetLastError(savedError);
+#endif
+}
+
+inline void TraceSocialClubMapping(const char* phase, std::wstring_view requested, std::wstring_view returned,
+                                  bool registered, bool called = false)
+{
+#ifdef CFX_CORE_MAPPING_DIAGNOSTICS
+    constexpr std::wstring_view filename = L"socialclub.dll";
+    const auto separator = requested.find_last_of(L"\\/");
+    const auto basename = requested.substr(separator == std::wstring_view::npos ? 0 : separator + 1);
+    if (basename.size() != filename.size()) return;
+    for (size_t index = 0; index < filename.size(); ++index)
+    {
+        auto character = basename[index];
+        if (character >= L'A' && character <= L'Z') character += L'a' - L'A';
+        if (character != filename[index]) return;
+    }
+    TraceMappingProvider(phase, registered, called, !returned.empty() && returned != requested);
+#endif
+}
+}
