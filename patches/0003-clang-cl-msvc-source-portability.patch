diff --git a/code/client/shared/Win32Intrinsics.h b/code/client/shared/Win32Intrinsics.h
new file mode 100644
index 0000000000000000000000000000000000000000..d32c8ff23eb1f22a5e68de8af371d81e8ff13c11
--- /dev/null
+++ b/code/client/shared/Win32Intrinsics.h
@@ -0,0 +1,19 @@
+#pragma once
+
+#include <intrin.h>
+
+namespace cfx::compat
+{
+#if defined(_M_AMD64)
+inline void WriteGsQword(unsigned long offset, unsigned __int64 value)
+{
+#if defined(__clang__)
+    // Clang declares __writegsqword but does not lower it to an x64 intrinsic.
+    using GsWord = unsigned __int64 __attribute__((address_space(256)));
+    *reinterpret_cast<volatile GsWord*>(static_cast<unsigned __int64>(offset)) = value;
+#else
+    __writegsqword(offset, value);
+#endif
+}
+#endif
+}
