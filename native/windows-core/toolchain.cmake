set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(CFX_PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(CFX_MSVC_ROOT "${CFX_PROJECT_ROOT}/toolchains/msvc-2022" CACHE PATH "Official Microsoft toolchain extraction")
set(CFX_MSVC_VERSION "14.44.35207" CACHE STRING "MSVC directory version")
set(CFX_WINSDK_VERSION "10.0.26100.0" CACHE STRING "Windows SDK directory version")
set(CFX_LLVM_BIN "/opt/homebrew/opt/llvm/bin" CACHE PATH "Native LLVM binaries")
set(CFX_LLD_BIN "/opt/homebrew/opt/lld/bin" CACHE PATH "Native LLD binaries")
set(CMAKE_C_COMPILER "${CFX_LLVM_BIN}/clang-cl")
set(CMAKE_CXX_COMPILER "${CFX_LLVM_BIN}/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER "${CFX_LLD_BIN}/lld-link")
set(CMAKE_AR "${CFX_LLVM_BIN}/llvm-lib")
set(CMAKE_RC_COMPILER "${CFX_LLVM_BIN}/llvm-rc")
set(CMAKE_MT "${CFX_LLVM_BIN}/llvm-mt")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL" CACHE STRING "Match official /MD runtime")
set(CFX_VC "${CFX_MSVC_ROOT}/VC/Tools/MSVC/${CFX_MSVC_VERSION}")
set(CFX_SDK "${CFX_MSVC_ROOT}/Windows Kits/10")
set(CFX_WIN_INCLUDE_DIRS "${CFX_VC}/include"
  "${CFX_SDK}/Include/${CFX_WINSDK_VERSION}/ucrt"
  "${CFX_SDK}/Include/${CFX_WINSDK_VERSION}/shared"
  "${CFX_SDK}/Include/${CFX_WINSDK_VERSION}/um"
  "${CFX_SDK}/Include/${CFX_WINSDK_VERSION}/winrt")
set(CMAKE_C_STANDARD_INCLUDE_DIRECTORIES ${CFX_WIN_INCLUDE_DIRS})
set(CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES ${CFX_WIN_INCLUDE_DIRS})
set(CFX_WIN_LINK_PATHS
  "/libpath:\"${CFX_VC}/lib/x64\" /libpath:\"${CFX_SDK}/Lib/${CFX_WINSDK_VERSION}/ucrt/x64\" /libpath:\"${CFX_SDK}/Lib/${CFX_WINSDK_VERSION}/um/x64\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${CFX_WIN_LINK_PATHS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CFX_WIN_LINK_PATHS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${CFX_WIN_LINK_PATHS}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
